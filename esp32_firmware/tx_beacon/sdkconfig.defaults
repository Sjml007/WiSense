# ESP-IDF minimal configuration for WiSense-Twin tx_beacon firmware
# Sets high-resolution 1000Hz tick rate, optimizes WiFi buffers, and disables AMPDU aggregation.

CONFIG_PARTITION_TABLE_OFFSET=0xa000
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=128
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_FREERTOS_HZ=1000
